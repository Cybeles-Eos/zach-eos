---
import ResumeModal from "./resume-modal.astro";
---

<div class="main--header">

    <div>
        <a href="#" class="header-logo">
            <img src="/images/logo.svg" alt="Logo">
        </a>

        <div class="header-actions">
            <a href="tel:+639125240151" class="btn btn--primary" aria-label="Call (+63) 912 524 0151">
                <span class="btn__label">(+63) 912 524 0151</span>
