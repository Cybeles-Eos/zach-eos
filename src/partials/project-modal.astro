<div
	class="project-modal"
	data-project-modal
	aria-hidden="true"
	role="dialog"
	aria-labelledby="project-modal-cta-title"
>
	<div class="project-modal__panel" id="project-modal-panel">
		<button
			type="button"
			class="project-modal__close"
			data-project-modal-close
			aria-label="Close"
		>
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
				<path
					d="M1 1L13 13M13 1L1 13"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"></path>
			</svg>
		</button>

		<div class="project-modal__services">
			<article class="project-modal__service">
				<div class="project-modal__service-icon" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M12 14C12.8215 14 13.4873 13.2325 13.4873 12.2857C13.4873 10.7872 13.4208 9.791 14.4489 8.60607C14.7393 8.27133 14.7393 7.72867 14.4489 7.39393C13.4208 6.20903 13.4873 5.21277 13.4873 3.71429C13.4873 2.76751 12.8215 2 12 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
						<path d="M4.00065 14C3.17921 14 2.5133 13.2325 2.5133 12.2857C2.5133 10.7872 2.57983 9.791 1.5518 8.60607C1.26138 8.27133 1.26138 7.72867 1.5518 7.39393C2.55729 6.23501 2.5133 5.22661 2.5133 3.71429C2.5133 2.76751 3.17921 2 4.00065 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</div>
				<h3 class="project-modal__service-title">Fullstack Development</h3>
				<p class="project-modal__service-text">
					Building responsive websites applications with clean, scalable and efficient code.
				</p>
			</article>

			<article class="project-modal__service">
				<div class="project-modal__service-icon" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
						<g clip-path="url(#clip-project-modal-palette)">
							<path d="M14.6673 8.00004C14.6673 4.31814 11.6825 1.33337 8.00065 1.33337C4.31875 1.33337 1.33398 4.31814 1.33398 8.00004C1.33398 11.6819 4.31875 14.6667 8.00065 14.6667C8.56178 14.6667 9.33398 14.7442 9.33398 14C9.33398 13.594 9.12278 13.2808 8.91305 12.9696C8.60612 12.5144 8.30218 12.0636 8.66732 11.3334C9.11178 10.4445 9.85252 10.4445 10.9883 10.4445C11.5563 10.4445 12.2229 10.4445 13.0007 10.3334C14.4013 10.1333 14.6673 9.27231 14.6673 8.00004Z" stroke="currentColor" stroke-width="1.1"/>
							<path d="M6.33398 6.66663C6.88627 6.66663 7.33398 6.21891 7.33398 5.66663C7.33398 5.11434 6.88627 4.66663 6.33398 4.66663C5.7817 4.66663 5.33398 5.11434 5.33398 5.66663C5.33398 6.21891 5.7817 6.66663 6.33398 6.66663Z" stroke="currentColor"/>
							<path d="M11 7.33337C11.5523 7.33337 12 6.88566 12 6.33337C12 5.78109 11.5523 5.33337 11 5.33337C10.4477 5.33337 10 5.78109 10 6.33337C10 6.88566 10.4477 7.33337 11 7.33337Z" stroke="currentColor"/>
							<path d="M4.75 10H4.66667M4.83333 10C4.83333 10.0921 4.75871 10.1667 4.66667 10.1667C4.57462 10.1667 4.5 10.0921 4.5 10C4.5 9.90797 4.57462 9.83337 4.66667 9.83337C4.75871 9.83337 4.83333 9.90797 4.83333 10Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
						</g>
						<defs>
							<clipPath id="clip-project-modal-palette">
								<rect width="16" height="16" fill="white"/>
							</clipPath>
						</defs>
					</svg>
				</div>
				<h3 class="project-modal__service-title">UI/UX &amp; Web Design</h3>
				<p class="project-modal__service-text">
					Designing intuitive interfaces and modern layouts focused on usability and visual consistency.
				</p>
			</article>
		</div>

		<div class="project-modal__cta">
			<div class="project-modal__cta-copy">
				<h2 id="project-modal-cta-title" class="project-modal__cta-title">
					Building Better Web Experiences
				</h2>
				<p class="project-modal__cta-text">
					Creating functional, user-friendly, and modern web solutions through development and design.
				</p>
			</div>

			<a href="#" class="project-modal__cta-link">
				Let's work together
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
				</svg>
			</a>

			<div class="project-modal__cta-decor" aria-hidden="true">
				<span></span>
				<span></span>
				<span></span>
			</div>
		</div>
	</div>
</div>
