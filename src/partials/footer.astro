---
const year = new Date().getFullYear();
---
<section class="footer-cta glb-pad-inline">
	<div class="footer-cta__inner ">
		<img src="/images/cta-globe.svg" alt="footer-cta">
	</div>
</section>
<footer class="site-footer">
	<div class="site-footer__inner glb-pad-inline">
		<div class="site-footer__main">
			<div class="site-footer__brand">
				<a href="/" class="site-footer__logo" aria-label="Home">
					<img src="/images/logo.svg" alt="Zach" width="80" height="30" />
				</a>
				<p class="site-footer__tagline">
					Junior full-stack developer building clean, modern websites, portfolios, and web systems.
				</p>
			</div>

			<div class="site-footer__column">
				<h3 class="site-footer__heading">General Links</h3>
				<nav class="site-footer__nav" aria-label="Footer navigation">
					<a href="/">Home</a>
					<a href="/about">About</a>
					<a href="/experiences">Experiences</a>
					<a href="/projects">Projects</a>
				</nav>
			</div>

			<div class="site-footer__column">
				<h3 class="site-footer__heading">Projects</h3>
				<nav class="site-footer__nav" aria-label="Footer navigation">
					<a href="/">Servease Platform</a>
					<a href="/about">Easy Consult By Zima Medical</a>
					<a href="/experiences">Monte Carlo South</a>
					<a href="/projects">Signexus | UK Base platform</a>
				</nav>
			</div>

			<div class="site-footer__column">
				<h3 class="site-footer__heading">Experiences</h3>
				<ul class="site-footer__experiences">
					<li>
						<a href="mailto:zach@zach.com">My Internship Experience as a Visual and Web Developer</a>
					</li>
					<li>
						<a href="tel:+639125240151">My Internship Experience as a Visual and Web Developer</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="site-footer__bottom">
			<p>&copy; {year} Zach. All rights reserved.</p>
			<div class="site-footer__connect">
				<span class="site-footer__connect-label">Connect:</span>
				<a href="https://instagram.com/" target="_blank" rel="noopener noreferrer">Instagram</a>
				<a href="https://indeed.com/" target="_blank" rel="noopener noreferrer">Indeed</a>
			</div>
		</div>
	</div>
</footer>
