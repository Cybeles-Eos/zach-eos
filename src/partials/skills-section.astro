---
import { TECH_LANGUAGES, TECH_BY_CATEGORY } from "../data/techLanguages";
import SkillsCapsule from "../components/skills-capsule.astro";

const catalogGroups = [
	{ title: "Frontend Tools", items: TECH_BY_CATEGORY.frontend },
	{ title: "Backend Tools", items: TECH_BY_CATEGORY.backend },
	{ title: "Tools", items: TECH_BY_CATEGORY.tools },
];
---

<section class="section--skills" data-skills-section>
	<div class="section--skills__hero glb-pad-inline">
		<h2>
			Technologies I Use To Build
			<span>Modern Web Applications</span>
		</h2>
		<p>
			I use frontend, backend, database, design, and development tools to build responsive,
			secure, and user-friendly web applications.
		</p>
		<button
			type="button"
			class="section--skills__arrange"
			data-skills-arrange
			aria-label="Re-arrange technologies"
		>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path
					d="M13.5522 9.02762H10.5384C10.1388 9.0272 9.75547 9.18524 9.47232 9.46708C9.18917 9.74892 9.02935 10.1316 9.02791 10.5311V13.545C9.0277 13.7434 9.06663 13.9399 9.14246 14.1232C9.2183 14.3066 9.32955 14.4732 9.46985 14.6135C9.61015 14.7537 9.77674 14.865 9.96009 14.9408C10.1434 15.0167 10.3399 15.0556 10.5384 15.0554H13.5522C13.9516 15.0537 14.334 14.8938 14.6157 14.6107C14.8974 14.3276 15.0553 13.9443 15.0549 13.545V10.5311C15.0551 10.3337 15.0164 10.1382 14.9409 9.95577C14.8655 9.77337 14.7548 9.60763 14.6152 9.46806C14.4757 9.32848 14.3099 9.2178 14.1275 9.14236C13.9451 9.06692 13.7496 9.02819 13.5522 9.02839M5.18257 9.02762H2.16868C1.76937 9.02988 1.38718 9.19009 1.10561 9.47326C0.824053 9.75642 0.66601 10.1395 0.666016 10.5388V13.5527C0.665812 13.7501 0.70454 13.9456 0.779983 14.128C0.855427 14.3104 0.966105 14.4762 1.10568 14.6157C1.24526 14.7553 1.41099 14.866 1.5934 14.9414C1.7758 15.0169 1.97129 15.0556 2.16868 15.0554H5.18257C5.58195 15.0558 5.9652 14.8979 6.24833 14.6162C6.53146 14.3345 6.69137 13.9521 6.69302 13.5527V10.5388C6.69322 10.3404 6.65429 10.1439 6.57846 9.96057C6.50262 9.77723 6.39137 9.61063 6.25107 9.47034C6.11078 9.33004 5.94418 9.21879 5.76084 9.14295C5.57749 9.06712 5.38098 9.02819 5.18257 9.02839M5.18257 0.666505H2.16868C1.97129 0.6663 1.7758 0.705028 1.5934 0.780472C1.41099 0.855915 1.24526 0.966593 1.10568 1.10617C0.966105 1.24575 0.855427 1.41148 0.779983 1.59388C0.70454 1.77629 0.665812 1.97178 0.666016 2.16917V5.18306C0.665601 5.58244 0.823537 5.96569 1.10521 6.24882C1.38688 6.53195 1.76931 6.69186 2.16868 6.6935H5.18257C5.38098 6.69371 5.57749 6.65478 5.76084 6.57895C5.94418 6.50311 6.11078 6.39186 6.25107 6.25156C6.39137 6.11126 6.50262 5.94467 6.57846 5.76132C6.65429 5.57798 6.69322 5.38147 6.69302 5.18306V2.16917C6.69137 1.7698 6.53146 1.38737 6.24833 1.1057C5.9652 0.824025 5.58195 0.66609 5.18257 0.666505ZM13.5522 0.666505H10.5384C10.139 0.66609 9.75572 0.824025 9.47259 1.1057C9.18946 1.38737 9.02955 1.7698 9.02791 2.16917V5.18306C9.02811 5.58359 9.18731 5.96766 9.47053 6.25088C9.75375 6.5341 10.1378 6.6933 10.5384 6.6935H13.5522C13.9516 6.69186 14.334 6.53195 14.6157 6.24882C14.8974 5.96569 15.0553 5.58244 15.0549 5.18306V2.16917C15.0551 1.97178 15.0164 1.77629 14.9409 1.59388C14.8655 1.41148 14.7548 1.24575 14.6152 1.10617C14.4757 0.966593 14.3099 0.855915 14.1275 0.780472C13.9451 0.705028 13.7496 0.6663 13.5522 0.666505Z"
					stroke="white"
					stroke-width="1.33333"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>

	<div class="section--skills__stage" data-skills-stage>
		{TECH_LANGUAGES.map((item) => <SkillsCapsule item={item} physics />)}
	</div>

	<div class="skills-catalog glb-pad-inline" data-skills-catalog hidden>
		{
			catalogGroups.map((group) => (
				<div class="skills-catalog__group">
					<h3 class="skills-catalog__title">{group.title}</h3>
					<div class="skills-catalog__list">
						{group.items.map((item) => (
							<SkillsCapsule item={item} />
						))}
					</div>
				</div>
			))
		}
	</div>
</section>

<script>
	import { initSkillsPhysics } from "../scripts/skills-physics";

	let physics: ReturnType<typeof initSkillsPhysics> | null = null;
	let arrangeBtn: HTMLButtonElement | null = null;

	const onArrange = () => physics?.toggleArrange();

	const setup = () => {
		physics?.destroy();
		arrangeBtn?.removeEventListener("click", onArrange);

		const stage = document.querySelector<HTMLElement>("[data-skills-stage]");
		const section = document.querySelector<HTMLElement>("[data-skills-section]");
		arrangeBtn = document.querySelector<HTMLButtonElement>("[data-skills-arrange]");
		if (!stage || !section) return;

		physics = initSkillsPhysics(stage, section);
		arrangeBtn?.addEventListener("click", onArrange);
	};

	setup();
	document.addEventListener("astro:after-swap", setup);
</script>
