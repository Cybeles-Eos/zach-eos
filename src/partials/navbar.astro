<script>
	const root = document.documentElement;

	const getProjectModal = () =>
		document.querySelector<HTMLElement>("[data-project-modal]");

	const isProjectModalOpen = () =>
		getProjectModal()?.classList.contains("is-open") ?? false;

	const openProjectModal = () => {
		const modal = getProjectModal();
		const toggle = document.querySelector<HTMLButtonElement>(
			"[data-project-modal-toggle]",
		);
		if (!modal) return;

		modal.classList.add("is-open");
		modal.setAttribute("aria-hidden", "false");
		toggle?.setAttribute("aria-expanded", "true");

		modal.querySelector<HTMLButtonElement>(".project-modal__close")?.focus();
	};

	const closeProjectModal = () => {
		const modal = getProjectModal();
		const toggle = document.querySelector<HTMLButtonElement>(
			"[data-project-modal-toggle]",
		);
		if (!modal || !modal.classList.contains("is-open")) return;

		modal.classList.remove("is-open");
		modal.setAttribute("aria-hidden", "true");
		toggle?.setAttribute("aria-expanded", "false");
	};

	const swapTheme = () => {
		const theme = root.dataset.theme === "dark" ? "light" : "dark";
		root.dataset.theme = theme;
		localStorage.setItem("theme", theme);
	};

	// delegated because a client-side page swap replaces the button node while
	// this module keeps the listener it registered on the very first load
	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement | null;
		if (!target) return;

		if (target.closest("[data-project-modal-toggle]")) {
			if (!isProjectModalOpen()) openProjectModal();
			else closeProjectModal();
			return;
		}

		if (target.closest("[data-project-modal-close]")) {
			closeProjectModal();
			return;
		}

		if (isProjectModalOpen() && !target.closest("[data-project-modal]")) {
			closeProjectModal();
		}

		const toggle = target.closest<HTMLButtonElement>("[data-theme-toggle]");
		if (!toggle) return;

		const startViewTransition = document.startViewTransition?.bind(document);

		if (!startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) {
			swapTheme();
			return;
		}

		// percentages resolve against the transition snapshot itself, so the origin
		// cannot drift the way pixel maths does once zoom or a scrollbar is involved.
		// 50% is dead centre horizontally, and 150% always reaches the far corner
		const bar = toggle.closest(".navbar-global") ?? toggle;
		const { top, height } = bar.getBoundingClientRect();
		const y = ((top + height / 2) / document.documentElement.clientHeight) * 100;

		startViewTransition(swapTheme).ready.then(() => {
			root.animate(
				{
					clipPath: [`circle(0% at 50% ${y}%)`, `circle(150% at 50% ${y}%)`],
				},
				{
					duration: 600,
					easing: "ease-in-out",
					pseudoElement: "::view-transition-new(root)",
				},
			);
		});
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeProjectModal();
	});

	document.addEventListener("astro:after-swap", closeProjectModal);
</script>
