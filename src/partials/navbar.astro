<script>
	const root = document.documentElement;
	const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

	const swapTheme = () => {
		const theme = root.dataset.theme === "dark" ? "light" : "dark";
		root.dataset.theme = theme;
		localStorage.setItem("theme", theme);
	};

	toggle?.addEventListener("click", () => {
		const startViewTransition = document.startViewTransition?.bind(document);

		if (!startViewTransition || matchMedia("(prefers-reduced-motion: reduce)").matches) {
			swapTheme();
			return;
		}

		// percentages resolve against the transition snapshot itself, so the origin
		// cannot drift the way pixel maths does once zoom or a scrollbar is involved.
		// 50% is dead centre horizontally, and 150% always reaches the far corner
		const bar = toggle.closest(".navbar-global") ?? toggle;
		const { top, height } = bar.getBoundingClientRect();
		const y = ((top + height / 2) / document.documentElement.clientHeight) * 100;

		startViewTransition(swapTheme).ready.then(() => {
			root.animate(
				{
					clipPath: [`circle(0% at 50% ${y}%)`, `circle(150% at 50% ${y}%)`],
				},
				{
					duration: 600,
					easing: "ease-in-out",
					pseudoElement: "::view-transition-new(root)",
				},
			);
		});
	});
</script>
