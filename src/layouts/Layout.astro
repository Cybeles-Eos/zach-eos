---
import { ClientRouter } from "astro:transitions";
import ScreenLoader from "../partials/screen-loader.astro";
import Footer from "../partials/footer.astro";
import "../styles/app.scss";
import "lenis/dist/lenis.css";

const FEATURES = {
	// Lenis smooth scrolling. false falls back to native scrolling.
	smoothScroll: true,

	// Set to false to gives plain, unanimated navigation.
	pageTransition: true,
 
	// screenLoaderPaths: ["/", "/about"], Leave empty to disable the loader on every page.
	screenLoaderPaths: ["/"],

	// cursorFollowerPaths: ["/", "/about"], Leave empty to disable the circle on every page.
	cursorFollowerPaths: ["/projects/fullstack", "/"],

	// Default theme to use until the visitor picks one for themselves.
	defaultTheme: "dark",
};

const normalizePath = (path: string) => {
	const trimmed = path.replace(/\/+$/, "");
	return trimmed === "" ? "/" : trimmed;
};

const showScreenLoader = FEATURES.screenLoaderPaths.some(
	(path) => normalizePath(path) === normalizePath(Astro.url.pathname),
);

interface Props {
	title?: string;
	description?: string;
	image?: string;
	url?: string;
}

const {
	title = "Zach | Creative Frontend Developer Portfolio",
	description = "Hi, I'm Zach — a creative frontend developer. I craft clean, responsive, and user-friendly websites that bring ideas to life.",
	image = "/meta-image-1.png",
	url = Astro.url.href,
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const imageUrl = new URL(image, siteOrigin).href;
const pageUrl = new URL(url, siteOrigin).href;
---

<!doctype html>
<html lang="en" data-smooth-scroll={String(FEATURES.smoothScroll)}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />

		<link rel="icon" href="/favicon/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
		<link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:type" content="website" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />

		<title>{title}</title>
		<slot name="head" />
		{FEATURES.pageTransition && <ClientRouter />}
		<script is:inline define:vars={{ defaultTheme: FEATURES.defaultTheme }}>
			// runs before paint so a saved dark theme doesn't flash light first
			(() => {
				const applyTheme = () => {
					document.documentElement.dataset.theme = localStorage.getItem("theme") ?? defaultTheme;
				};

				applyTheme();
				// the router rewrites every root attribute on swap, so the theme is put back
				// while the new page is still hidden behind the transition
				document.addEventListener("astro:after-swap", applyTheme);
			})();
		</script>
	</head>
	<body>
		<ScreenLoader enabled={showScreenLoader} />
		<div
			class="cursor-follower"
			aria-hidden="true"
			data-cursor-follower
			data-cursor-paths={JSON.stringify(FEATURES.cursorFollowerPaths)}
			transition:persist
		></div>
		<slot />
		<Footer transition:persist />
	</body>
</html>

<script is:inline src="/js/skrollr.js"></script>
<script>
	import type Lenis from "lenis";

	declare global {
		interface Window {
			skrollr: {
				init: (options?: Record<string, unknown>) => SkrollrInstance;
				get: () => SkrollrInstance | undefined;
			};
		}
	}

	type SkrollrInstance = {
		destroy: () => void;
		refresh: () => void;
	};

	const root = document.documentElement;
	const mobileMq = window.matchMedia("(max-width: 492px)");
	const touchMq = window.matchMedia("(pointer: coarse)");

	let lenis: Lenis | null = null;
	let skrollrInstance: SkrollrInstance | null = null;

	const useLenis =
		root.dataset.smoothScroll === "true" && !touchMq.matches;

	// skrollr reads data-bottom-top at init — CSS media queries cannot change
	// HTML attributes, so desktop/mobile values live in separate attributes
	// and get copied onto data-bottom-top before init (and on resize).
	const applyResponsiveSkrollr = () => {
		document.querySelectorAll("[data-bottom-top-desktop]").forEach((el) => {
			const keyframe = mobileMq.matches
				? el.getAttribute("data-bottom-top-mobile")
				: el.getAttribute("data-bottom-top-desktop");

			if (keyframe) el.setAttribute("data-bottom-top", keyframe);
		});
	};

	const destroySkrollr = () => {
		skrollrInstance?.destroy();
		skrollrInstance = null;
	};

	const initSkrollr = () => {
		destroySkrollr();

		if (!document.querySelector(".skrollable")) return;

		applyResponsiveSkrollr();

		skrollrInstance = window.skrollr.init({
			forceHeight: false,
			// Lenis smooths desktop scroll; mobile uses native scroll — skrollr
			// only needs to read position and apply transforms.
			smoothScrolling: false,
			mobileCheck: () => false,
		});
	};

	// Re-init after view transitions so skrollr binds to the new DOM nodes.
	// Layout scripts persist across swaps, so a one-time init goes stale.
	const setupSkrollr = () => {
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				initSkrollr();
				skrollrInstance?.refresh();
			});
		});
	};

	mobileMq.addEventListener("change", () => {
		if (!skrollrInstance) return;

		applyResponsiveSkrollr();
		skrollrInstance.refresh();
	});

	document.addEventListener("astro:after-swap", setupSkrollr);
	setupSkrollr();

	// every page opens at its hero, browser back and forward included, so no
	// navigation can inherit the offset of the page it came from.
	//
	// Lenis must be stopped here rather than scrolled: scrollTo() returns early
	// whenever the requested target already matches its own, which is always the
	// case at this point because the router has moved the window first. A wheel
	// animation still in flight therefore survives and drags the incoming page
	// back down over the following frames. stop() cancels it outright, and
	// start() resyncs Lenis to wherever the window actually ended up.
	const scrollToTop = () => {
		lenis?.stop();
		window.scrollTo(0, 0);
		lenis?.resize();
		lenis?.start();
		skrollrInstance?.refresh();
	};

	document.addEventListener("astro:after-swap", () => {
		scrollToTop();
		// once more after the incoming page has had a frame to settle its layout
		requestAnimationFrame(scrollToTop);
	});

	if (useLenis) {
		import("lenis").then(({ default: LenisCtor }) => {
			const instance = new LenisCtor();
			lenis = instance;

			instance.on("scroll", () => {
				skrollrInstance?.refresh();
			});

			const tick = (time: number) => {
				instance.raf(time);
				requestAnimationFrame(tick);
			};

			const start = () => {
				instance.start();
				requestAnimationFrame(tick);
			};

			// don't run smooth scroll until the preloader has fully released the page.
			// aria-busy rules out a loader that already finished before Lenis arrived,
			// which would otherwise leave us waiting on an event that has been and gone
			if (document.querySelector('[data-screen-loader][aria-busy="true"]')) {
				instance.stop();
				window.addEventListener("loader:complete", start, { once: true });
			} else {
				start();
			}
		});
	}

	// Soft peach circle that eases toward the pointer and grows over headings.
	const initCursorFollower = () => {
		const finePointer = window.matchMedia("(pointer: fine)");
		const desktopMq = window.matchMedia("(min-width: 993px)");
		const cursor = document.querySelector<HTMLElement>("[data-cursor-follower]");
		if (!cursor) return;

		let mouseX = 0;
		let mouseY = 0;
		let currentX = 0;
		let currentY = 0;
		let rafId = 0;
		let hasMoved = false;
		const ease = 0.12;
		const headingSelector = "h1, h2, h3, h4, h5, h6";

		const normalizeCursorPath = (path: string) => {
			const trimmed = path.replace(/\/+$/, "");
			return trimmed === "" ? "/" : trimmed;
		};

		let allowedPaths: string[] = [];
		try {
			allowedPaths = JSON.parse(cursor.dataset.cursorPaths || "[]") as string[];
		} catch {
			allowedPaths = [];
		}

		const isPathAllowed = () =>
			allowedPaths.some(
				(path) => normalizeCursorPath(path) === normalizeCursorPath(window.location.pathname),
			);

		const isEnabled = () => finePointer.matches && desktopMq.matches && isPathAllowed();

		const setHeadingState = (active: boolean) => {
			cursor.classList.toggle("is-heading", active);
		};

		const onPointerMove = (event: PointerEvent) => {
			if (!isEnabled()) return;

			mouseX = event.clientX;
			mouseY = event.clientY;

			if (!hasMoved) {
				hasMoved = true;
				currentX = mouseX;
				currentY = mouseY;
				cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;
				cursor.classList.add("is-visible");
			}
		};

		const onPointerOver = (event: PointerEvent) => {
			if (!isEnabled()) return;
			const target = event.target;
			if (!(target instanceof Element)) return;
			if (target.closest(headingSelector)) setHeadingState(true);
		};

		const onPointerOut = (event: PointerEvent) => {
			if (!isEnabled()) return;
			const target = event.target;
			const related = event.relatedTarget;
			if (!(target instanceof Element)) return;
			if (!target.closest(headingSelector)) return;
			if (related instanceof Element && related.closest(headingSelector)) return;
			setHeadingState(false);
		};

		const animate = () => {
			if (isEnabled() && hasMoved) {
				currentX += (mouseX - currentX) * ease;
				currentY += (mouseY - currentY) * ease;
				cursor.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(-50%, -50%)`;
			}
			rafId = requestAnimationFrame(animate);
		};

		const syncAvailability = () => {
			if (!isEnabled()) {
				cursor.classList.remove("is-visible", "is-heading");
				hasMoved = false;
			}
		};

		window.addEventListener("pointermove", onPointerMove, { passive: true });
		document.addEventListener("pointerover", onPointerOver);
		document.addEventListener("pointerout", onPointerOut);
		finePointer.addEventListener("change", syncAvailability);
		desktopMq.addEventListener("change", syncAvailability);
		document.addEventListener("astro:after-swap", () => {
			setHeadingState(false);
			syncAvailability();
		});

		rafId = requestAnimationFrame(animate);

		return () => cancelAnimationFrame(rafId);
	};

	initCursorFollower();
</script>
