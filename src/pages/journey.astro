<script>
	const initJourney = () => {
		const contents = document.querySelector('.jddm-c-contents')
		const nav = document.querySelector('.jddm-navs ul')

		if (!contents || !nav) return

		const journeyContents =
			contents.querySelectorAll('.jddm-c-check-style')

		// Clear existing navigation
		nav.innerHTML = ''

		journeyContents.forEach((journey) => {
			const heading =
				journey.querySelector('.main-headline-jry')

			if (!heading) return

			// Create ID from title
			const title = heading.textContent.trim()

			const id = title
				.toLowerCase()
				.replace(/[^\w\s-]/g, '')
				.replace(/\s+/g, '-')

			heading.id = id

			// Get journey metadata
			const category = journey.dataset.category || ''
			const date = journey.dataset.date || ''

			// Create navigation item
			const li = document.createElement('li')

			li.innerHTML = `
				<a href="#${id}">
					<span>${heading.textContent.trim()}</span>

					<div class="foo-a-itj">
						<span>${category}</span>
						<span>${date}</span>
					</div>
				</a>
			`

			nav.appendChild(li)
		})

		const navLinks = nav.querySelectorAll('a')
		const headings =
			contents.querySelectorAll('.main-headline-jry')

		const updateActiveNav = () => {
			let activeIndex = 0
			const offset = 700

			headings.forEach((heading, index) => {
				const rect = heading.getBoundingClientRect()

				if (rect.top <= offset) {
					activeIndex = index
				}
			})

			navLinks.forEach((link, index) => {
				link.classList.toggle(
					'active-link-j',
					index === activeIndex
				)
			})
		}

		navLinks.forEach((link) => {
			link.addEventListener('click', (event) => {
				event.preventDefault()

				const targetId = link.getAttribute('href')

				if (!targetId) return

				const target = document.querySelector(targetId)

				if (!target) return

				const offset = 400

				const targetPosition =
					target.getBoundingClientRect().top +
					window.scrollY -
					offset

				window.scrollTo({
					top: targetPosition,
					behavior: 'smooth'
				})
			})
		})

		window.addEventListener('scroll', updateActiveNav)
		window.addEventListener('resize', updateActiveNav)

		updateActiveNav()
	}

	document.addEventListener('astro:page-load', initJourney)
</script>
