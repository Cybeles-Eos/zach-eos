---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";

const journeys = await getCollection("journeys");
---

<Layout
	title="Journey | Zach Portfolio"
	description="Zach's professional journey — roles, projects, and the work behind his frontend and full-stack development."
>
	<main class="journey">
		<Header />
		<Navbar />

		<section class="section--hero glb-sec-pad-out">
			<div class="section--hero__grid" aria-hidden="true"></div>
			<div class="section--hero__con">
				<div class="section--hero__main glb-sec-pad">
					<h1>Every journey built through experience and <span>growth</span></h1>
					<p>Explore the projects, achievements, lessons, and experiences that shaped my skills in design, development, and creating digital experiences.</p>
					<img src="/images/journey-svg.svg" alt="vector" class="vector-svg-jny">
					<svg width="2158" height="2158" class="section--hero--svg" viewBox="0 0 2158 2158" fill="none" xmlns="http://www.w3.org/2000/svg">
						<g opacity="0.2" filter="url(#filter0_f_2690_2519)">
						<circle cx="1078.62" cy="1078.62" r="523.621" fill="#00A14C"/>
						</g>
						<g opacity="0.2" filter="url(#filter1_f_2690_2519)">
						<circle cx="1115.2" cy="1071.25" r="412.48" fill="#07D468"/>
						</g>
						<g opacity="0.2" filter="url(#filter2_f_2690_2519)">
						<circle cx="1115.2" cy="1049.99" r="290.366" fill="white"/>
						</g>
						<defs>
						<filter id="filter0_f_2690_2519" x="0" y="0" width="2157.24" height="2157.24" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter1_f_2690_2519" x="147.716" y="103.766" width="1934.96" height="1934.96" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter2_f_2690_2519" x="269.831" y="204.621" width="1690.73" height="1690.73" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						</defs>
					</svg>		
				</div>
			</div>
		</section>

		<section class="section--story glb-sec-pad-out">
			<div class="section--story__con">
				<div class="section--story__main glb-sec-pad">
					
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
