---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";

const journeys = await getCollection("journeys");
---

<Layout
	title="Journey | Zach Portfolio"
	description="Zach's professional journey — roles, projects, and the work behind his frontend and full-stack development."
>
	<main class="journey">
		<Header />
		<Navbar />

		<section class="section--hero glb-sec-pad-out">
			<div class="section--hero__con">
				<div class="section--hero__main glb-sec-pad">
					<h1>Every journey built through experience and <span>growth</span></h1>
					<p>Explore the projects, achievements, lessons, and experiences that shaped my skills in design, development, and creating digital experiences.</p>
					<img src="/images/journey-svg.svg" alt="vector" class="vector-svg-jny">
				</div>
			</div>
		</section>

		<section class="section--story glb-sec-pad-out">
			<div class="section--story__con">
				<div class="section--story__main glb-sec-pad">
					
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>



		<!-- <section class="section--list glb-pad-inline">
			<div class="section--list__content">
				<h2>All <span>steps</span></h2>
				<p>Each card is a markdown file. Open one to read the full story.</p>

				<pre>{JSON.stringify(journeys, null, 2)}</pre>

				<ul class="journey-cards">
					{journeys.map((entry: CollectionEntry<"journeys">) => (
						<li>

							<a class="journey-card" href={`/journey/${entry.id}`}>
							{entry.data.banner && (
								<img src={entry.data.banner} alt="banner" />
							)}
								<span class="journey-card__category">{entry.data.category}</span>
								<h3>{entry.data.title}</h3>
								<p>{entry.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section> -->
	</main>
</Layout>
