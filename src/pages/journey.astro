---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Cta from "../partials/cta.astro";
import Header from "../partials/header.astro";

const journeys = await getCollection("journeys");
const fullstackProjects = await getCollection("fullstackProjects");
const completedProjectCount = fullstackProjects.filter((project) => project.data.isActive !== false).length;
const completedProjectCountLabel = `${completedProjectCount}+`;

