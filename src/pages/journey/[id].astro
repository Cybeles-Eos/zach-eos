---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";

export async function getStaticPaths() {
	const journeys = await getCollection("journeys");

	return journeys.map((entry: CollectionEntry<"journeys">) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<"journeys">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
	title={`${entry.data.title} | Journey`}
	description={entry.data.description}
>
	<main class="journey-detail">
		<Header />
		<Navbar sty={true} />

		<section class="section--hero glb-sec-pad-out">
			<div class="section--hero__grid" aria-hidden="true"></div>
			<div class="section--hero__con">
				<div class="section--hero__main glb-sec-pad">
					<span>INTERNSHIP</span>
					<h1>My internship experience as a visual and web developer</h1>
					<p>Explore the projects, achievements, lessons, and experiences that shaped my skills in design, development, and creating digital experiences.</p>

