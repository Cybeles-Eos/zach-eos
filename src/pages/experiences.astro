---
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";
---

<Layout
	title="Experiences | Zach Portfolio"
	description="Zach's professional experiences — roles, projects, and the work behind his frontend and full-stack development."
>
	<main class="experiences">
		<Header />
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block">
			<div class="section--hero__main">
				<h1>My <span>experiences</span></h1>
				<p>
					This is a placeholder Experiences page. Add roles, internships, and project highlights
					here.
				</p>
			</div>
		</section>

		<section class="section--timeline glb-pad-inline">
			<div class="section--timeline__content">
				<h2>Work <span>history</span></h2>
				<p>Dummy section for jobs, internships, and career milestones.</p>
			</div>
		</section>

		<section class="section--highlights"></section>
	</main>

	<div style="height: 100vh; width: 100%; background-color: #0d739b;"></div>
</Layout>
