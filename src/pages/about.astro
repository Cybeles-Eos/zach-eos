<script>
	import EmblaCarousel from "embla-carousel";

	let emblaApi;

	const initCertificates = () => {
		const certContainer = document.querySelector(".cert-con");
		const dotsContainer = document.querySelector(".cert-dots");
		const certTitle = document.querySelector(".cert-title span");

		if (!certContainer || !dotsContainer) return;

		if (emblaApi) {
			emblaApi.destroy();
			emblaApi = undefined;
		}

		emblaApi = EmblaCarousel(certContainer, {
			loop: false,
			dragFree: true,
			containScroll: "trimSnaps"
		});

		const createDots = () => {
			dotsContainer.innerHTML = "";

			const snapCount = emblaApi.scrollSnapList().length;

			emblaApi.scrollSnapList().forEach((_, index) => {
				const dot = document.createElement("span");

				dot.classList.add("dot");

				if (index === emblaApi.selectedScrollSnap()) {
					dot.classList.add("active");
				}

				dotsContainer.appendChild(dot);
			});
			if (certTitle) {
				certTitle.textContent = `(${snapCount})`;
			}
		};

		const updateDots = () => {
			const dots = dotsContainer.querySelectorAll(".dot");
			const selected = emblaApi.selectedScrollSnap();

			dots.forEach((dot, index) => {
				dot.classList.toggle("active", index === selected);
			});
		};

		createDots();

		emblaApi.on("select", updateDots);
		emblaApi.on("reInit", createDots);
	};
	const initGithubBoard = async () => {
		const board = document.querySelector(".github-main__board");
		const months = document.querySelector(".github-main__months");
		const total = document.querySelector(".github-total");

		if (!board || !months) return;

		try {
			/*
			* ----------------------------------------
			* DATE RANGE
			* ----------------------------------------
			*/

			const today = new Date();
			today.setHours(0, 0, 0, 0);

			const oneYearAgo = new Date(today);
			oneYearAgo.setFullYear(
				oneYearAgo.getFullYear() - 1
			);

			/*
			* IMPORTANT:
			* Do NOT use toISOString() for GitHub dates.
			* It can shift the date because of timezone.
			*/

			const formatDateKey = (date) => {
				const year = date.getFullYear();
				const month = String(
					date.getMonth() + 1
				).padStart(2, "0");
				const day = String(
					date.getDate()
				).padStart(2, "0");

				return `${year}-${month}-${day}`;
			};

			/*
			* ----------------------------------------
			* COMPLETE CALENDAR WEEKS
			* ----------------------------------------
			*/

			const calendarStart = new Date(oneYearAgo);

			calendarStart.setDate(
				calendarStart.getDate() -
				calendarStart.getDay()
			);

			const calendarEnd = new Date(today);

			calendarEnd.setDate(
				calendarEnd.getDate() +
				(6 - calendarEnd.getDay())
			);

			/*
			* ----------------------------------------
			* FETCH CURRENT + PREVIOUS YEAR
			* ----------------------------------------
			*/

			const startYear =
				oneYearAgo.getFullYear();

			const endYear =
				today.getFullYear();

			const response = await fetch(
				`https://github-contributions-api.jogruber.de/v4/Cybeles-Eos?y=${startYear}&y=${endYear}`
			);

			if (!response.ok) {
				throw new Error(
					"Failed to fetch GitHub contributions"
				);
			}

			const data = await response.json();

			/*
			* ----------------------------------------
			* STORE CONTRIBUTIONS BY DATE
			* ----------------------------------------
			*/

			const contributionMap = new Map();

			data.contributions.forEach((day) => {
				contributionMap.set(
					day.date,
					day
				);
			});

			board.innerHTML = "";
			months.innerHTML = "";

			/*
			* ----------------------------------------
			* TOTAL CONTRIBUTIONS
			* ----------------------------------------
			*/

			let contributionTotal = 0;

			for (
				let date = new Date(oneYearAgo);
				date <= today;
				date.setDate(
					date.getDate() + 1
				)
			) {
				const dateKey =
					formatDateKey(date);

				const day =
					contributionMap.get(dateKey);

				if (day) {
					contributionTotal += day.count;
				}
			}

			if (total) {
				total.textContent =
					contributionTotal.toLocaleString();
			}

			/*
			* ----------------------------------------
			* BUILD WEEKS
			* ----------------------------------------
			*/

			const weeks = [];

			let currentDate =
				new Date(calendarStart);

			while (currentDate <= calendarEnd) {

				const week = [];

				for (let row = 0; row < 7; row++) {

					const date =
						new Date(currentDate);

					const dateKey =
						formatDateKey(date);

					const day =
						contributionMap.get(
							dateKey
						);

					const insideRange =
						date >= oneYearAgo &&
						date <= today;

					week.push({
						dateObject: date,

						/*
						* Real contribution data
						*/
						count: day?.count || 0,
						level: day?.level || 0,

						/*
						* Only padding before/after
						* the actual one-year range.
						*/
						empty: !insideRange
					});

					currentDate.setDate(
						currentDate.getDate() + 1
					);
				}

				weeks.push(week);
			}

			/*
			* ----------------------------------------
			* RENDER CALENDAR
			* ----------------------------------------
			*/

			weeks.forEach((week) => {

				week.forEach((day) => {

					const square =
						document.createElement("div");

					square.classList.add(
						"github-day"
					);

					const formattedDate =
						day.dateObject.toLocaleDateString(
							"en-US",
							{
								month: "long",
								day: "numeric",
								year: "numeric"
							}
						);

					/*
					* --------------------------------
					* FUTURE DAYS
					* --------------------------------
					*
					* Example:
					* September 7
					* September 8
					*
					* These are outside today's range,
					* but still receive a tooltip.
					*/

					if (
						day.dateObject > today &&
						day.dateObject <= calendarEnd
					) {
						square.title =
							`No contributions on ${formattedDate}`;

						square.classList.add(
							"github-day--empty"
						);

						board.appendChild(square);

						return;
					}

					/*
					* --------------------------------
					* OLD PADDING DAYS
					* --------------------------------
					*/

					if (
						day.dateObject < oneYearAgo
					) {
						square.classList.add(
							"github-day--empty"
						);

						board.appendChild(square);

						return;
					}

					/*
					* --------------------------------
					* CONTRIBUTION LEVEL
					* --------------------------------
					*/

					if (day.level > 0) {
						square.classList.add(
							`github-day--${day.level}`
						);
					}

					/*
					* --------------------------------
					* TOOLTIP
					* --------------------------------
					*
					* This works even when count = 0.
					*/

					square.title =
						day.count === 0
							? `No contributions on ${formattedDate}`
							: `${day.count} contributions on ${formattedDate}`;

					board.appendChild(square);
				});
			});

			/*
			* ----------------------------------------
			* MONTH LABELS
			* ----------------------------------------
			*/

			const monthPositions = new Map();

			weeks.forEach(
				(week, weekIndex) => {

					week.forEach((day) => {

						const date =
							day.dateObject;

						if (
							date < oneYearAgo ||
							date > today
						) {
							return;
						}

						const monthKey =
							`${date.getFullYear()}-${date.getMonth()}`;

						if (
							!monthPositions.has(
								monthKey
							)
						) {
							monthPositions.set(
								monthKey,
								weekIndex
							);
						}
					});
				}
			);

			monthPositions.forEach(
				(weekIndex, monthKey) => {

					const [year, month] =
						monthKey
							.split("-")
							.map(Number);

					const monthElement =
						document.createElement(
							"span"
						);

					monthElement.classList.add(
						"github-month"
					);

					const date =
						new Date(
							year,
							month,
							1
						);

					monthElement.textContent =
						date.toLocaleDateString(
							"en-US",
							{
								month: "short"
							}
						);

					const percentage =
						(weekIndex /
							weeks.length) *
						100;

					monthElement.style.left =
						`${percentage}%`;

					months.appendChild(
						monthElement
					);
				}
			);

		} catch (error) {

			console.error(
				"GitHub contribution error:",
				error
			);

			board.innerHTML = `
				<p class="github-error">
					Unable to load GitHub activity.
				</p>
			`;
		}
	};

	document.addEventListener("astro:page-load", () => {
		initCertificates();
		initGithubBoard();
	});
</script>