---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";

const journeys = await getCollection("journeys");
---

<Layout
	title="Contact | Zach Portfolio"
	description="Get in touch with Zach — whether you have a question, want to collaborate, or just say hello."
>
	<main class="contact">
		<Header />
		<Navbar />

		<section class="section--cls glb-sec-pad-out">
			<div class="section--cls__con">
				<div class="section--cls__main">

				</div>
			</div>
		</section>
		<section class="section--line glb-sec-pad-out">
			<div class="section--line__con">
				<div class="section--line__main">

				</div>

				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
