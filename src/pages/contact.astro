---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";

const journeys = await getCollection("journeys");
---

<Layout
	title="Contact | Zach Portfolio"
	description="Get in touch with Zach — whether you have a question, want to collaborate, or just say hello."
>
	<main class="contact">
		<Header />
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block">
			<div class="section--hero__main">
				<h1>Contact <span>me</span></h1>
				<p>
					This is a placeholder Contact page. Add your contact information and ways to get in touch.
				</p>
			</div>
		</section>

		<section class="section--story glb-sec-pad-out">
			<div class="section--story__con">
				<div class="section--story__main ">
					<a href="#">
						<img src="/images/research-def-banner.png" alt="featured image" />

						<div class="con-details-f">
							<div class="con-details-f__left">
								<p class="con-details-f--category">INTERNSHIP</p>
								<h2 class="con-details-f--title">My internship experience as a visual and web developer</h2>
								<p class="con-details-f--p">Explore the projects, achievements, lessons, and experiences that shaped my skills in design, development, and creating digital experiences.</p>
							</div>
							<div class="con-details-f__right">
								<p class="con-details-f--date">Aug 20, 2026</p>
							</div>
						</div>
					</a>
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>

		<section class="section--main glb-sec-pad-out">
			<div class="section--main__con">
				<div class="section--main__main ">

					<div class="section--main__contents">
						<!-- <a href="#" class="mmc-box-j">
							<div class="mmc-box-j--img">
								<img src="/images/def.png" alt="Journey Image" />
							</div>
							<div class="mmc-box-j__txt">
								<span class="mmc-box-j__txt--category">INTERNSHIP</span>
								<h4 class="mmc-box-j__txt--title">My internship experience as a visual and web developer</h4>
								<p class="mmc-box-j__txt--p">My first real-world role learning how teams ship websites, not just how to code them.</p>
								<p class="mmc-box-j__txt--date">Aug 20, 2026</p>
							</div>
						</a> -->
						{journeys.map((entry: CollectionEntry<"journeys">) => (
							
							<a href={`/journey/${entry.id}`} class="mmc-box-j">
								<div class="mmc-box-j--img">
									{entry.data.banner ? (
										<img src={entry.data.banner} alt="banner" />
									) : (
										<img src="/images/def.png" alt="Journey Image" />
									)}
								</div>
								<div class="mmc-box-j__txt">
									<span class="mmc-box-j__txt--category">{entry.data.category}</span>
									<h4 class="mmc-box-j__txt--title">{entry.data.title}</h4>
									<p class="mmc-box-j__txt--p">{entry.data.description}</p>
									<p class="mmc-box-j__txt--date">Aug 20, 2026</p>
								</div>
							</a>
						))}
					</div>
			
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section> 
	</main>
</Layout>
