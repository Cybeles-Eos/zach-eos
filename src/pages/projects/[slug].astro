---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";

import Cta from "../../partials/cta.astro";

import SkillsBox from "../../components/skills-box.astro";
import { TECH_LANGUAGES } from "../../data/techLanguages";

const fullstackProjects = await getCollection("fullstackProjects");
const activeProjects = fullstackProjects.filter((project) => project.data.isActive !== false);
const completedProjectCount = activeProjects.length;
const completedProjectCountLabel = `${completedProjectCount}+`;
const projectRows = activeProjects
	.filter((project) => project.data.isFeatured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.map((project, index) => ({
		title: project.data.title,
		description: project.data.description,
		year: project.data.year,
		category: project.data.category,
		link: `/projects/${project.id}`,
		thumbnail: project.data.thumbnail,
		thumbnailAlt: project.data.thumbnailAlt,
		previewMedia: project.data.previewMedia,
		rowNumber: String(index + 1).padStart(2, "0"),
	}));

const projectPreviewImagePreloads = [
	...new Set(
		projectRows
			.filter((project) => project.previewMedia.type === "image")
			.map((project) => project.previewMedia.src),
	),
];


export async function getStaticPaths() {
	const projects = await getCollection("fullstackProjects");

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const caseStudySections = project.data.caseStudySections ?? [];
const projectDetails = project.data.projectDetails ?? {
	dateLabel: project.data.date.toLocaleDateString("en-US", {
		month: "long",
		year: "numeric",
	}),
	tags: [project.data.category],
};
const [projectContributionPrimary = project.data.projectContribution, ...projectContributionRest] =
	project.data.projectContribution.split("·");
const projectContributionPrimaryLabel = projectContributionRest.length
	? `${projectContributionPrimary.trim()} ·`
	: projectContributionPrimary;
const projectContributionDetail = projectContributionRest.join("·").trim();
---

<Layout
	title={project.data.metaTitle}
	description={project.data.metaDescription}
	image={project.data.metaBanner}
>
	<Fragment slot="head">
		{projectPreviewImagePreloads.map((href) => (
			<link rel="preload" href={href} as="image" fetchpriority="low" />
		))}
	</Fragment>
	<main class="project-detail">
		<Header sty={true} />
		<Navbar />
		
		<section class="section--hero glb-sec-pad-out" style={`background-image: url("${project.data.thumbnail}");`}>
			<div class="section--hero__con">
				<div class="section--hero__main glb-sec-pad">

					<div class="som-content">
						<div class="som-content__detail">
							<h2>{project.data.title}</h2>
							<p>{project.data.description}</p>
						</div>

						<div class="som-content__info">
							<div>
								<span class="som-content--title">MY ROLE</span>
								<div class="som-content--label">
									<div class="svg">
										<svg width="17" height="18" viewBox="0 0 17 18" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M12.75 12L15.5833 9L12.75 6" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M4.2513 6L1.41797 9L4.2513 12" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M10.2721 3L6.73047 15" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</div>
									<span class="line"></span>
									<p>{project.data.projectRole}</p>
								</div>
							</div> 
							<div>
								<span class="som-content--title">CONTRIBUTION</span>
								<div class="som-content--label">
									<div class="svg">
										<svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M1.875 1.875V11.875C1.875 12.2065 2.0067 12.5245 2.24112 12.7589C2.47554 12.9933 2.79348 13.125 3.125 13.125H13.125" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M4.375 10C4.6875 8.75 5.3125 5.625 6.875 5.625C8.125 5.625 8.125 7.5 9.375 7.5C10.9375 7.5 12.1875 4.375 12.5 3.125" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</div>

									<span class="line"></span>
									<p>
										<span>{projectContributionPrimaryLabel}</span>
										{projectContributionDetail && ` ${projectContributionDetail}`}
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section--oneline glb-sec-pad-out">
			<div class="section--oneline__con">
				<div class="section--oneline__main">
					<div class="sonel-main-detail">
						<div class="sol-pretitle">
							<span class="sol-pretitle__txt">The One Line</span>
						</div>
						<h3>{project.data.oneLineTitle}</h3>
						<p class="glb-detail-txt">{project.data.oneLineDescription}</p>
						<a href="/contact" class="btn btn--main-hero">Let’s Work Together</a>
					</div>
					<div class="sonel-main-info">
						<img src={project.data.oneLineImage} class="sonel-main-info__pic" alt={project.data.oneLineImageAlt}>
						<img src="/images/journey-svg.svg" class="sonel-main-info__svg" alt="vector">
					</div>
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>

		<section class="section--content glb-sec-pad-out">
			<div class="section--content__con">
				<div class="section--content__main glb-sec-pad">

					<div class="scm-navs" data-case-study-nav>
						<button
							class="scm-navs__toggle"
							type="button"
							aria-haspopup="true"
							aria-expanded="false"
							data-case-study-toggle
						>
							<span>Read Case Study</span>
						</button>
						<div class="scm-navs__menu" data-case-study-menu>
							{caseStudySections.map((section, index) => {
								const sectionNumber = String(index + 1).padStart(2, "0");

								return (
									<a href={`#${section.id}`}>
										<span>{sectionNumber}</span>
										<span>{section.label}</span>
									</a>
								);
							})}
						</div>
						<div class="scm-navs__details">
							<h3>Project Details</h3>
							<div class="scm-navs__details-list">
								<div class="scm-navs__details-row">
									<span class="scm-navs__details-icon" aria-hidden="true">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M8 2V5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
											<path d="M16 2V5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
											<path d="M3.5 9H20.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
											<path d="M5 4H19C20.1046 4 21 4.89543 21 6V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V6C3 4.89543 3.89543 4 5 4Z" stroke="currentColor" stroke-width="2"/>
										</svg>
									</span>
									<span>{projectDetails.dateLabel}</span>
								</div>
								<div class="scm-navs__details-row">
									<span class="scm-navs__details-icon" aria-hidden="true">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
											<path d="M20.5 13.5L13.5 20.5C12.6716 21.3284 11.3284 21.3284 10.5 20.5L3.5 13.5V4.5H12.5L20.5 12.5C20.7761 12.7761 20.7761 13.2239 20.5 13.5Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
											<path d="M7.5 8.5H7.51" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
										</svg>
									</span>
									<span>{projectDetails.tags.map((tag) => `#${tag}`).join(", ")}</span>
								</div>
							</div>
						</div>
					</div>
					<div class="scm-detail">
						<!-- <div class="scm-detail__box" id={section.id}>
							<div class="sol-pretitle">
								<div class="sol-pretitle__line"></div>
								<span class="sol-pretitle__txt">01 _OVERVIEW</span>
							</div>
							<h3>From design concept to a complete and manageable website.</h3>
						
							<p class="glb-detail-txt">Monte Carlo Builders needed a professional website that clearly presents its construction services, projects, and company information. I worked on translating the approved design into responsive web pages while keeping the layout clean, consistent, and easy to navigate across desktop and mobile devices.</p>
							<div class="glb-highlight-box">
								<span>Working on Monte Carlo Builders helped me understand how design, frontend development, and CMS logic work together in a complete website.</span>
							</div>
						</div> -->


						{caseStudySections.map((section, index) => {
							const sectionNumber = String(index + 1).padStart(2, "0");

							return (
								<>
									{index > 0 && <hr />}
									<div class="scm-detail__box" id={section.id}>
										<div class="sol-pretitle">
											<div class="sol-pretitle__line"></div>
											<span class="sol-pretitle__txt">{sectionNumber} _{section.label}</span>
										</div>
										<h3>{section.title}</h3>
										{section.paragraphs.map((paragraph) => (
											<p class="glb-detail-txt">{paragraph}</p>
										))}
										{section.highlight && (
											<div class="glb-highlight-box">
												<span>{section.highlight}</span>
											</div>
										)}
									</div>
								</>
							);
						})}
					</div>

				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>

        <section class="section--projects glb-sec-pad-out">
            <div class="section--projects__con">
                <div class="section--projects__main glb-sec-pad">
                    <h2>Explore more of my Selected projects.</h2>
					
					<div class="project-list" data-project-preview-list>
						

							{projectRows.map((project) => (
								<a
									href={project.link}
									class="project-list-box"
									data-project-preview-row
									data-preview-type={project.previewMedia.type}
									data-preview-src={project.previewMedia.src}
									data-preview-alt={project.previewMedia.alt}
									data-preview-poster={project.previewMedia.poster ?? ""}
								>
									<div class="project-list-box__left">
										<div class="dots">
											<span></span>
											<span></span>
										</div>
										<div class="details">
											<h3>{project.title} </h3>
											<p>{project.description}</p>
										</div>
									</div>
									<div class="project-list-box__right">
										{/* <span class="project-list-box__number" aria-hidden="true">{project.rowNumber}</span> */}
										<img src={project.thumbnail} alt={project.thumbnailAlt}>
										<svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M16.8401 12.1457L-0.00179153 12.1457L-0.00179141 9.37843L16.8401 9.37843L9.41814 1.95649L11.3746 -4.70426e-07L22.1367 10.7621L11.3746 21.5242L9.41814 19.5677L16.8401 12.1457Z" fill="currentColor"/>
										</svg>
									</div>
								</a>
							))}

					
						<div class="project-hover-preview" data-project-hover-preview aria-hidden="true"></div>
					</div>
                </div>
                
                <svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
                </svg>
                <svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
                </svg>
            </div>
        </section>

		<Cta label="Let's Start A Project" />

		<section class="section--cls glb-sec-pad-out">
			<div class="section--cls__con">
				<div class="section--cls__main">

				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	const setupCaseStudyNav = () => {
		if (document.documentElement.dataset.caseStudyNavReady === "true") return;
		document.documentElement.dataset.caseStudyNavReady = "true";

		const mobileQuery = window.matchMedia("(max-width: 992px)");

		const closeNav = (nav: HTMLElement) => {
			nav.classList.remove("is-open");
			nav.querySelector<HTMLButtonElement>("[data-case-study-toggle]")?.setAttribute("aria-expanded", "false");
		};

		const closeAll = (except?: HTMLElement) => {
			const navs = [...document.querySelectorAll<HTMLElement>("[data-case-study-nav]")];

			navs.forEach((nav) => {
				if (nav !== except) closeNav(nav);
			});
		};

		document.addEventListener("click", (event) => {
			const target = event.target as HTMLElement | null;
			if (!target) return;

			const toggle = target.closest<HTMLButtonElement>("[data-case-study-toggle]");
			if (toggle) {
				if (!mobileQuery.matches) return;

				const nav = toggle.closest<HTMLElement>("[data-case-study-nav]");
				if (!nav) return;

				const isOpen = nav.classList.toggle("is-open");
				toggle.setAttribute("aria-expanded", String(isOpen));
				closeAll(nav);
				return;
			}

			const selectedLink = target.closest<HTMLAnchorElement>("[data-case-study-menu] a");
			if (selectedLink) {
				const nav = selectedLink.closest<HTMLElement>("[data-case-study-nav]");
				if (nav) closeNav(nav);
				return;
			}

			if (!mobileQuery.matches) return;
			if (target.closest("[data-case-study-nav]")) return;

			closeAll();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeAll();
		});
	};

	let teardownProjectHoverPreview = () => {};

	const initProjectHoverPreview = () => {
		teardownProjectHoverPreview();

		const projectList = document.querySelector("main.project-detail [data-project-preview-list]");
		const preview = document.querySelector("[data-project-hover-preview]");

		if (!projectList || !preview) return;

		const padding = 20;
		const offset = 22;
		let currentSrc = "";
		let currentX = padding;
		let currentY = padding;
		let targetX = padding;
		let targetY = padding;
		let animationFrame;
		let isPreviewVisible = false;
		let previewWidth = 330;
		let previewHeight = 206;
		const previewRows = [...projectList.querySelectorAll("[data-project-preview-row]")];
		const mediaCache = new Map();
		const mediaReadyCache = new Map();
		const cleanups = [];

		const applyPreviewPosition = () => {
			preview.style.setProperty("--preview-x", `${currentX}px`);
			preview.style.setProperty("--preview-y", `${currentY}px`);
		};

		const animatePreviewPosition = () => {
			const easing = 0.18;
			const deltaX = targetX - currentX;
			const deltaY = targetY - currentY;

			currentX += deltaX * easing;
			currentY += deltaY * easing;

			if (Math.abs(deltaX) < 0.4) currentX = targetX;
			if (Math.abs(deltaY) < 0.4) currentY = targetY;

			applyPreviewPosition();

			if (isPreviewVisible && (currentX !== targetX || currentY !== targetY)) {
				animationFrame = requestAnimationFrame(animatePreviewPosition);
				return;
			}

			animationFrame = undefined;
		};

		const queuePreviewPosition = () => {
			if (animationFrame) return;
			animationFrame = requestAnimationFrame(animatePreviewPosition);
		};

		const updatePreviewSize = () => {
			const rect = preview.getBoundingClientRect();
			previewWidth = rect.width;
			previewHeight = rect.height;
		};

		const getPreviewPosition = (event) => {
			const viewportWidth = window.innerWidth;
			const viewportHeight = window.innerHeight;
			let nextX = event.clientX + offset;
			let nextY = event.clientY + offset;

			nextX = Math.min(Math.max(nextX, padding), viewportWidth - previewWidth - padding);
			nextY = Math.min(Math.max(nextY, padding), viewportHeight - previewHeight - padding);

			return { x: nextX, y: nextY };
		};

		const setPreviewPosition = (event, snap = false) => {
			const nextPosition = getPreviewPosition(event);
			targetX = nextPosition.x;
			targetY = nextPosition.y;

			if (snap) {
				currentX = targetX;
				currentY = targetY;
				applyPreviewPosition();
				return;
			}

			queuePreviewPosition();
		};

		const resetPreviewPan = () => {
			preview.classList.remove("is-panning");
			preview.style.setProperty("--preview-scroll-distance", "0px");
		};

		const setPreviewPan = (mediaWidth, mediaHeight) => {
			if (!mediaWidth || !mediaHeight) return;

			const renderedMediaHeight = previewWidth * (mediaHeight / mediaWidth);
			const scrollDistance = Math.max(0, renderedMediaHeight - previewHeight);

			if (scrollDistance <= 8) {
				resetPreviewPan();
				return;
			}

			preview.style.setProperty("--preview-scroll-distance", `-${scrollDistance}px`);
			preview.classList.add("is-panning");
		};

		const syncPreviewPan = (media) => {
			if (media instanceof HTMLVideoElement) {
				setPreviewPan(media.videoWidth, media.videoHeight);
				return;
			}

			setPreviewPan(media.naturalWidth, media.naturalHeight);
		};

		const getPreviewMediaData = (row) => ({
			type: row.dataset.previewType,
			src: row.dataset.previewSrc,
			alt: row.dataset.previewAlt || "",
			poster: row.dataset.previewPoster || ""
		});

		const createPreviewMedia = ({ type, src, alt, poster }) => {
			if (type === "video") {
				const video = document.createElement("video");
				video.muted = true;
				video.loop = true;
				video.playsInline = true;
				video.preload = "auto";
				video.autoplay = true;
				video.setAttribute("aria-label", alt);
				if (poster) video.poster = poster;
				video.addEventListener("loadedmetadata", () => {
					if (currentSrc === src && preview.contains(video)) syncPreviewPan(video);
				});
				video.src = src;
				video.load();
				return video;
			}

			const image = new Image();
			image.alt = alt;
			image.decoding = "async";
			image.loading = "eager";
			image.fetchPriority = "low";
			image.addEventListener("load", () => {
				if (currentSrc === src && preview.contains(image)) syncPreviewPan(image);
			});
			image.src = src;
			mediaReadyCache.set(
				src,
				(image.decode ? image.decode() : Promise.resolve()).catch(() => {}),
			);
			return image;
		};

		const getCachedMedia = (row) => {
			const mediaData = getPreviewMediaData(row);
			if (!mediaData.src) return undefined;

			if (!mediaCache.has(mediaData.src)) {
				mediaCache.set(mediaData.src, createPreviewMedia(mediaData));
			}

			return mediaCache.get(mediaData.src);
		};

		const preloadPreviewMedia = () => {
			previewRows.forEach((row) => getCachedMedia(row));
		};

		const warmClosestPreviewMedia = (event) => {
			const row = event.currentTarget;
			getCachedMedia(row);
		};

		const setPreviewMedia = (row) => {
			const { src } = getPreviewMediaData(row);

			if (!src || src === currentSrc) return;

			const media = getCachedMedia(row);
			if (!media) return;

			currentSrc = src;
			resetPreviewPan();
			preview.replaceChildren(media);
			updatePreviewSize();

			if (media instanceof HTMLVideoElement) {
				if (media.readyState >= 1) syncPreviewPan(media);
				media.play().catch(() => {});
			} else {
				if (media.complete) {
					syncPreviewPan(media);
				} else {
					resetPreviewPan();
				}

				mediaReadyCache.get(src)?.then(() => {
					if (currentSrc === src && preview.contains(media)) syncPreviewPan(media);
				});
			}
		};

		const showPreview = (event) => {
			const row = event.currentTarget;
			setPreviewMedia(row);
			updatePreviewSize();
			setPreviewPosition(event, !isPreviewVisible);
			isPreviewVisible = true;
			preview.classList.add("is-visible");
			preview.setAttribute("aria-hidden", "false");
			queuePreviewPosition();
		};

		const hidePreview = () => {
			isPreviewVisible = false;
			if (animationFrame) {
				cancelAnimationFrame(animationFrame);
				animationFrame = undefined;
			}
			preview.classList.remove("is-visible");
			preview.setAttribute("aria-hidden", "true");
		};

		const hidePreviewOnRowLeave = (event) => {
			const nextTarget = event.relatedTarget;
			if (nextTarget instanceof Element && nextTarget.closest("[data-project-preview-row]")) return;
			hidePreview();
		};

		preloadPreviewMedia();

		previewRows.forEach((row) => {
			row.addEventListener("pointerover", warmClosestPreviewMedia, { passive: true });
			row.addEventListener("focus", warmClosestPreviewMedia);
			row.addEventListener("pointerenter", showPreview);
			row.addEventListener("pointermove", setPreviewPosition);
			row.addEventListener("pointerleave", hidePreviewOnRowLeave);
			cleanups.push(() => {
				row.removeEventListener("pointerover", warmClosestPreviewMedia);
				row.removeEventListener("focus", warmClosestPreviewMedia);
				row.removeEventListener("pointerenter", showPreview);
				row.removeEventListener("pointermove", setPreviewPosition);
				row.removeEventListener("pointerleave", hidePreviewOnRowLeave);
			});
		});

		projectList.addEventListener("pointerleave", hidePreview);
		window.addEventListener("blur", hidePreview);
		window.addEventListener("resize", updatePreviewSize);

		cleanups.push(() => {
			projectList.removeEventListener("pointerleave", hidePreview);
			window.removeEventListener("blur", hidePreview);
			window.removeEventListener("resize", updatePreviewSize);
			hidePreview();
		});

		teardownProjectHoverPreview = () => {
			cleanups.forEach((cleanup) => cleanup());
			teardownProjectHoverPreview = () => {};
		};
	};

	document.addEventListener("astro:page-load", setupCaseStudyNav);
	document.addEventListener("astro:page-load", initProjectHoverPreview);
	document.addEventListener("astro:before-swap", () => teardownProjectHoverPreview());
	setupCaseStudyNav();
	initProjectHoverPreview();
</script>
