---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjectsByCategory } from "../../lib/content";

const projects = getProjectsByCategory("Fullstack");
---

<Layout
	title="Fullstack Projects | Zach Portfolio"
	description="Fullstack development projects by Zach — responsive websites and web applications built with clean, scalable code."
>
	<main class="projects projects--fullstack">
		<Header />
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block">
			<div class="section--hero__main">
				<h1>Fullstack <span>projects</span></h1>
				<p>
					Responsive websites and web applications built with clean, scalable, and efficient code.
				</p>
			</div>
		</section>

		<section class="section--grid glb-pad-inline">
			<CategoryFilter activeCategory="fullstack" />

			<div class="section--grid__header">
				<h2>Development <span>work</span></h2>
				<p>{projects.length} fullstack {projects.length === 1 ? "project" : "projects"}</p>
			</div>
			<div class="content-grid">
				{
					projects.length > 0 ? (
						projects.map((project) => (
							<ProjectCard project={project} />
						))
					) : (
						<p class="content-empty">No fullstack projects yet.</p>
					)
				}
			</div>
		</section>
	</main>
</Layout>
