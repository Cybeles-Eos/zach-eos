---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";

const projectRows = [
	{
		title: "Monte Carlo Builders",
		description: "My first real-world role learning how teams ship websites, not just how to code them.",
		year: "2026",
		category: "Web",
		link: "#",
		thumbnail: "/images/banner.png",
		thumbnailAlt: "banner",
		previewMedia: {
			type: "image",
			src: "/images/prev-img.png",
			alt: "Monte Carlo Builders project preview",
			poster: ""
		}
	},
	{
		title: "Monte Carlo Builders",
		description: "My first real-world role learning how teams ship websites, not just how to code them.",
		year: "2026",
		category: "Web",
		link: "#",
		thumbnail: "/images/banner.png",
		thumbnailAlt: "banner",
		previewMedia: {
			type: "image",
			src: "/banners/servease.png",
			alt: "Servease project preview",
			poster: ""
		}
	},
	{
		title: "Monte Carlo Builders",
		description: "My first real-world role learning how teams ship websites, not just how to code them.",
		year: "2026",
		category: "Web",
		link: "#",
		thumbnail: "/images/banner.png",
		thumbnailAlt: "banner",
		previewMedia: {
			type: "image",
			src: "/images/research-def-banner.png",
			alt: "Research proposal project preview",
			poster: ""
		}
	}
];

---

<Layout
	title="Fullstack Projects | Zach Portfolio"
	description="Fullstack development projects by Zach — responsive websites and web applications built with clean, scalable code."
>
	<main class="fullstack">
		<Header />
		<Navbar />

		<section class="section--hero glb-sec-pad-out">
