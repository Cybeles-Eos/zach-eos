---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjectsByCategory } from "../../lib/content";

const projects = getProjectsByCategory("UI/UX");
---

<Layout
	title="UI/UX Projects | Zach Portfolio"
	description="UI/UX and web design projects by Zach — intuitive interfaces and modern layouts focused on usability."
>
	<main class="projects projects--ui-ux">
		<Header />
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block">
			<div class="section--hero__main">
				<h1>UI/UX <span>projects</span></h1>
				<p>
					Intuitive interfaces and modern layouts focused on usability and visual consistency.
				</p>
			</div>
		</section>

		<section class="section--grid glb-pad-inline">
			<CategoryFilter activeCategory="ui/ux" />

			<div class="section--grid__header">
				<h2>Design <span>work</span></h2>
				<p>{projects.length} UI/UX {projects.length === 1 ? "project" : "projects"}</p>
			</div>
			<div class="content-grid">
				{
					projects.length > 0 ? (
						projects.map((project) => (
							<ProjectCard project={project} />
						))
					) : (
						<p class="content-empty">No UI/UX projects yet.</p>
					)
				}
			</div>
		</section>
	</main>
</Layout>
