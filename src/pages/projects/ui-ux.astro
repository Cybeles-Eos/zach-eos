---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";

const uiUxProjects = [
	{
		name: "FlowDash App",
		banner: "/images/scroll-banners/banner-1.png",
		tags: ["UI Design", "UX Flow", "Dashboard"],
		description: "A clean dashboard concept for tracking tasks, reports, and daily activity.",
		ctaLink: "/contact",
		content:
			"FlowDash focuses on simple navigation, readable cards, and clear actions so users can find important information quickly.",
	},
	{
		name: "FreshCart Mobile",
		banner: "/images/scroll-banners/banner-7.png",
		tags: ["Mobile UI", "Wireframe", "Shopping"],
		description: "A mobile shopping design with simple product browsing and checkout screens.",
		ctaLink: "/contact",
		content:
			"FreshCart uses friendly spacing, clear buttons, and easy product sections to make the shopping flow feel smooth.",
	},
	{
		name: "StudyHub Portal",
		banner: "/images/scroll-banners/banner-13.png",
		tags: ["Web Design", "Prototype", "Education"],
		description: "A student portal concept for lessons, schedules, and progress tracking.",
		ctaLink: "/contact",
		content:
			"StudyHub keeps learning tools organized with simple sections, soft colors, and quick access to class updates.",
	},
	{
		name: "CareSync Booking",
		banner: "/images/scroll-banners/banner-20.png",
		tags: ["UX Research", "Booking Flow", "Healthcare"],
		description: "A booking interface concept for choosing services, dates, and user details.",
		ctaLink: "/contact",
		content:
			"CareSync is designed around a short booking path, clear labels, and helpful steps that reduce user confusion.",
	},
];
---

<Layout
	title="UI/UX Projects | Zach Portfolio"
	description="UI/UX and web design projects by Zach — intuitive interfaces and modern layouts focused on usability."
>
	<main class="uix">
		<Header />
		<Navbar />

		<section class="section--hero glb-sec-pad-out">
			<div class="section--hero__grid" aria-hidden="true"></div>
			<div class="section--hero__con">
				<div class="section--hero__main glb-sec-pad">
					<h1>A motivated <span>web developer</span></h1>
					<p>Hi, my name is Zach. I’m a Junior Full-Stack Developer who enjoys building websites and creating UI/UX designs.</p>
					<img src="/images/abt-svg.svg" alt="vector" class="vector-svg-jny">
					<svg width="2158" height="2158" class="section--hero--svg" viewBox="0 0 2158 2158" fill="none" xmlns="http://www.w3.org/2000/svg">
						<g opacity="0.2" filter="url(#filter0_f_2690_2519)">
						<circle cx="1078.62" cy="1078.62" r="523.621" fill="#00A14C"/>
						</g>
						<g opacity="0.2" filter="url(#filter1_f_2690_2519)">
						<circle cx="1115.2" cy="1071.25" r="412.48" fill="#07D468"/>
						</g>
						<g opacity="0.2" filter="url(#filter2_f_2690_2519)">
						<circle cx="1115.2" cy="1049.99" r="290.366" fill="white"/>
						</g>
						<defs>
						<filter id="filter0_f_2690_2519" x="0" y="0" width="2157.24" height="2157.24" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter1_f_2690_2519" x="147.716" y="103.766" width="1934.96" height="1934.96" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter2_f_2690_2519" x="269.831" y="204.621" width="1690.73" height="1690.73" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						</defs>
					</svg>	

				</div>
			</div>
		</section>

		<section class="section--cta glb-sec-pad-out">
			<div class="section--cta__con">
				<div class="section--cta__main glb-sec-pad">

					<h2>Lets turn <span>ideas</span> into digital experiences</h2>
					<p class="section--cta__main--p">Whether it's a website, application, or digital solution, I can help turn your ideas into a functional and modern experience.</p>
					<a href="/projects" class="cls-cta">
						<span class="cls-cta__icon">
							<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M16.5 9H13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M4.5 9H1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M9 4.5V1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M9 16.5V13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</span>
						<span class="cls-cta__text">
							<span class="cls-cta__title">Lets start a project</span>
							<span class="cls-cta__count">20+ projects complete</span>
						</span>
					</a>
					<svg width="2158" height="2158" class="section--cta__main--svg" viewBox="0 0 2158 2158" fill="none" xmlns="http://www.w3.org/2000/svg">
						<g opacity="0.2" filter="url(#filter0_f_2690_2519)">
						<circle cx="1078.62" cy="1078.62" r="523.621" fill="#00A14C"/>
						</g>
						<g opacity="0.2" filter="url(#filter1_f_2690_2519)">
						<circle cx="1115.2" cy="1071.25" r="412.48" fill="#07D468"/>
						</g>
						<g opacity="0.2" filter="url(#filter2_f_2690_2519)">
						<circle cx="1115.2" cy="1049.99" r="290.366" fill="white"/>
						</g>
						<defs>
						<filter id="filter0_f_2690_2519" x="0" y="0" width="2157.24" height="2157.24" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter1_f_2690_2519" x="147.716" y="103.766" width="1934.96" height="1934.96" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter2_f_2690_2519" x="269.831" y="204.621" width="1690.73" height="1690.73" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						</defs>
					</svg>										
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="left-trb-n-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-n-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>

		<section class="section--cls glb-sec-pad-out">
			<div class="section--cls__con">
				<div class="section--cls__main">

				</div>
			</div>
		</section>

		<section class="project-content glb-sec-pad-out">
			<div class="project-content__main glb-sec-pad">
				<div class="project-content__header">
					<p>UI/UX Projects</p>
					<h2>Simple design concepts for clean user experiences.</h2>
				</div>

				<div class="project-content__grid">
					{uiUxProjects.map((project) => (
						<article class="project-card">
							<img src={project.banner} alt={`${project.name} banner`} class="project-card__banner" />
							<div class="project-card__body">
								<div class="project-card__tags">
									{project.tags.map((tag) => (
										<span>{tag}</span>
									))}
								</div>
								<h3>{project.name}</h3>
								<p class="project-card__description">{project.description}</p>
								<p>{project.content}</p>
								<a href={project.ctaLink}>View project</a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	</main>
</Layout>
