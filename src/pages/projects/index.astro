---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";

const uiUxProjects = [
	{
		name: "FlowDash App",
		banner: "/images/scroll-banners/banner-1.png",
		tags: ["UI Design", "UX Flow", "Dashboard"],
		description: "A clean dashboard concept for tracking tasks, reports, and daily activity.",
		ctaLink: "/contact"
	},
	{
		name: "FreshCart Mobile",
		banner: "/images/scroll-banners/banner-7.png",
		tags: ["Mobile UI", "Wireframe", "UX Flow", "Shopping"],
		description: "A mobile shopping design with simple product browsing and checkout screens.",
		ctaLink: "/contact"
	},
	{
		name: "StudyHub Portal",
		banner: "/images/scroll-banners/banner-13.png",
		tags: ["Web Design", "Prototype", "Education"],
		description: "A student portal concept for lessons, schedules, and progress tracking.",
		ctaLink: "/contact"
	},
	{
		name: "CareSync Booking",
		banner: "/images/scroll-banners/banner-20.png",
		tags: ["UX Research", "Booking Flow", "Healthcare"],
		description: "A booking interface concept for choosing services, dates, and user details.",
		ctaLink: "/contact"
	},
];

const projectRows = [];
for (let i = 0; i < uiUxProjects.length; i += 3) {
	projectRows.push(uiUxProjects.slice(i, i + 3));
}

const projectCategories = [...new Set(uiUxProjects.flatMap((project) => project.tags))];

---

<Layout
	title="Projects | Zach Portfolio"
	description="Browse Zach's projects — fullstack development and UI/UX design work across websites, portfolios, and web systems."
>
	<main class="projects projects--all">
		<Header />
		<Navbar />

		<section class="section--hero glb-sec-pad-out">
			<div class="section--hero__grid" aria-hidden="true"></div>
			<div class="section--hero__con">
				<div class="section--hero__main glb-sec-pad">
					<h1>Shaping better experience through every <span>projects</span></h1>
					<p>Explore a collection of projects I’ve worked on through freelance work, school and personal builds.</p>
					<img src="/images/uiux-vector.svg" alt="vector" class="vector-svg-uix">
					<svg width="2158" height="2158" class="section--hero--svg" viewBox="0 0 2158 2158" fill="none" xmlns="http://www.w3.org/2000/svg">
						<g opacity="0.2" filter="url(#filter0_f_2690_2519)">
						<circle cx="1078.62" cy="1078.62" r="523.621" fill="#00A14C"/>
						</g>
						<g opacity="0.2" filter="url(#filter1_f_2690_2519)">
						<circle cx="1115.2" cy="1071.25" r="412.48" fill="#07D468"/>
						</g>
						<g opacity="0.2" filter="url(#filter2_f_2690_2519)">
						<circle cx="1115.2" cy="1049.99" r="290.366" fill="white"/>
						</g>
						<defs>
						<filter id="filter0_f_2690_2519" x="0" y="0" width="2157.24" height="2157.24" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter1_f_2690_2519" x="147.716" y="103.766" width="1934.96" height="1934.96" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter2_f_2690_2519" x="269.831" y="204.621" width="1690.73" height="1690.73" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						</defs>
					</svg>		
				</div>
			</div>
		</section>

		<section class="section--main glb-sec-pad-out">
			<div class="section--main__con">
				<div class="section--main__main">
					<div class="main-navigation">
						<div class="main-navigation__search-bar">
							<div>
								<input type="text" placeholder="Search projects by type..." data-project-search>
								<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
									<path d="M15.7491 15.7491L12.4941 12.4941" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M8.25 14.25C11.5637 14.25 14.25 11.5637 14.25 8.25C14.25 4.93629 11.5637 2.25 8.25 2.25C4.93629 2.25 2.25 4.93629 2.25 8.25C2.25 11.5637 4.93629 14.25 8.25 14.25Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</div>
						</div>
						<div class="main-navigation__category">
							<div class="main-navigation__category--con" data-project-categories>
								<button type="button" class="ctgy-active" data-category="All">All</button>
								{projectCategories.map((category) => (
									<button type="button" data-category={category}>{category}</button>
								))}
							</div>
							<div class="main-navigation__category--dropdown" data-project-category-dropdown>
								<button
									type="button"
									class="main-navigation__category--dropdown-trigger"
									aria-expanded="false"
									data-project-category-trigger
								>
									<span data-project-category-label>All</span>
								</button>
								<ul class="main-navigation__category--dropdown-menu" data-project-category-menu hidden>
									<li>
										<button type="button" class="is-active" data-category="All">All</button>
									</li>
									{projectCategories.map((category) => (
										<li>
											<button type="button" data-category={category}>{category}</button>
										</li>
									))}
								</ul>
							</div>
						</div>
					</div>
					

					<div class="main-lists" data-project-list>
						{
							projectRows.map((row) => (
								<div class="main-lists--row">
									{row.map((project) => (
										<div class="box-mrl-p">
											<div class="box-mrl-p__img">
												<img src={project.banner} alt={project.name} />
											</div>
											<div class="box-mrl-p__detail">
												<h3>{project.name}</h3>
												<p>{project.description}</p>
												<div>
													<ul>
														{project.tags.map((tag) => (
															<li><span>{tag}</span></li>
														))}
													</ul>
												</div>
											</div>
										</div>
									))}
								</div>
							))
						}
					</div>
					
					<div class="empty-list" data-empty-list style="display: none;">
						<p>No results found.</p>
					</div>

					<script define:vars={{ projects: uiUxProjects, categories: projectCategories }}>
						const projectList = document.querySelector("[data-project-list]");
						const searchInput = document.querySelector("[data-project-search]");
						const categoryList = document.querySelector("[data-project-categories]");
						const categoryDropdown = document.querySelector("[data-project-category-dropdown]");
						const categoryTrigger = document.querySelector("[data-project-category-trigger]");
						const categoryLabel = document.querySelector("[data-project-category-label]");
						const categoryMenu = document.querySelector("[data-project-category-menu]");
						const emptyList = document.querySelector("[data-empty-list]");
						let selectedCategory = "All";

						const getItemsPerRow = () => {
							if (window.innerWidth <= 592) return 1;
							if (window.innerWidth <= 992) return 2;
							return 3;
						};

						const chunkProjects = (items, size) => {
							const rows = [];

							for (let i = 0; i < items.length; i += size) {
								rows.push(items.slice(i, i + size));
							}

							return rows;
						};

						const getFilteredProjects = () => {
							const searchValue = searchInput.value.trim().toLowerCase();

							return projects.filter((project) => {
								const matchesCategory =
									selectedCategory === "All" || project.tags.includes(selectedCategory);
								const searchableText = [
									project.name,
									project.description,
									...project.tags
								].join(" ").toLowerCase();
								const matchesSearch =
									searchValue === "" || searchableText.includes(searchValue);

								return matchesCategory && matchesSearch;
							});
						};

						const createCategoryButton = (category) => {
							const button = document.createElement("button");
							button.type = "button";
							button.dataset.category = category;
							button.textContent = category;

							if (category === selectedCategory) {
								button.classList.add("ctgy-active");
							}

							return button;
						};

						const renderCategoryButtons = () => {
							categoryList.replaceChildren(
								createCategoryButton("All"),
								...categories.map((category) => createCategoryButton(category))
							);
							renderMobileCategoryMenu();
						};

						const createMobileCategoryOption = (category) => {
							const item = document.createElement("li");
							const button = document.createElement("button");
							button.type = "button";
							button.dataset.category = category;
							button.textContent = category;

							if (category === selectedCategory) {
								button.classList.add("is-active");
							}

							item.append(button);
							return item;
						};

						const renderMobileCategoryMenu = () => {
							categoryLabel.textContent = selectedCategory;
							categoryMenu.replaceChildren(
								createMobileCategoryOption("All"),
								...categories.map((category) => createMobileCategoryOption(category))
							);
						};

						const closeMobileCategoryMenu = () => {
							categoryMenu.hidden = true;
							categoryTrigger.setAttribute("aria-expanded", "false");
						};

						const createProjectCard = (project) => {
							const card = document.createElement("div");
							card.className = "box-mrl-p";

							const imageWrap = document.createElement("div");
							imageWrap.className = "box-mrl-p__img";

							const image = document.createElement("img");
							image.src = project.banner;
							image.alt = project.name;
							imageWrap.append(image);

							const detail = document.createElement("div");
							detail.className = "box-mrl-p__detail";

							const title = document.createElement("h3");
							title.textContent = project.name;

							const description = document.createElement("p");
							description.textContent = project.description;

							const tagsWrap = document.createElement("div");
							const tagList = document.createElement("ul");

							project.tags.forEach((tag) => {
								const item = document.createElement("li");
								const label = document.createElement("span");
								label.textContent = tag;
								item.append(label);
								tagList.append(item);
							});

							tagsWrap.append(tagList);
							detail.append(title, description, tagsWrap);
							card.append(imageWrap, detail);

							return card;
						};

						const renderProjectRows = () => {
							const itemsPerRow = getItemsPerRow();
							const filteredProjects = getFilteredProjects();
							const hasSearchValue = searchInput.value.trim() !== "";
							projectList.replaceChildren();
							emptyList.style.display =
								hasSearchValue && filteredProjects.length === 0 ? "" : "none";

							chunkProjects(filteredProjects, itemsPerRow).forEach((row) => {
								const rowElement = document.createElement("div");
								rowElement.className = "main-lists--row";
								row.forEach((project) => rowElement.append(createProjectCard(project)));
								projectList.append(rowElement);
							});
						};

						categoryList.addEventListener("click", (event) => {
							const button = event.target.closest("button[data-category]");
							if (!button) return;

							selectedCategory = button.dataset.category;
							renderCategoryButtons();
							renderProjectRows();
						});

						categoryTrigger.addEventListener("click", () => {
							const isOpen = !categoryMenu.hidden;
							categoryMenu.hidden = isOpen;
							categoryTrigger.setAttribute("aria-expanded", String(!isOpen));
						});

						categoryMenu.addEventListener("click", (event) => {
							const button = event.target.closest("button[data-category]");
							if (!button) return;

							selectedCategory = button.dataset.category;
							renderCategoryButtons();
							renderProjectRows();
							closeMobileCategoryMenu();
						});

						document.addEventListener("click", (event) => {
							if (!categoryDropdown.contains(event.target)) {
								closeMobileCategoryMenu();
							}
						});

						document.addEventListener("keydown", (event) => {
							if (event.key === "Escape") {
								closeMobileCategoryMenu();
							}
						});

						searchInput.addEventListener("input", renderProjectRows);
						renderCategoryButtons();
						renderProjectRows();
						window.addEventListener("resize", renderProjectRows);
					</script>










				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>

		<section class="section--cta glb-sec-pad-out">
			<div class="section--cta__con">
				<div class="section--cta__main glb-sec-pad">

					<h2>Lets turn <span>ideas</span> into digital experiences</h2>
					<p class="section--cta__main--p">Whether it's a website, application, or digital solution, I can help turn your ideas into a functional and modern experience.</p>
					<a href="/projects" class="cls-cta">
						<span class="cls-cta__icon">
							<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M16.5 9H13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M4.5 9H1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M9 4.5V1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
								<path d="M9 16.5V13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</span>
						<span class="cls-cta__text">
							<span class="cls-cta__title">Lets start a project</span>
							<span class="cls-cta__count">20+ projects complete</span>
						</span>
					</a>
					<svg width="2158" height="2158" class="section--cta__main--svg" viewBox="0 0 2158 2158" fill="none" xmlns="http://www.w3.org/2000/svg">
						<g opacity="0.2" filter="url(#filter0_f_2690_2519)">
						<circle cx="1078.62" cy="1078.62" r="523.621" fill="#00A14C"/>
						</g>
						<g opacity="0.2" filter="url(#filter1_f_2690_2519)">
						<circle cx="1115.2" cy="1071.25" r="412.48" fill="#07D468"/>
						</g>
						<g opacity="0.2" filter="url(#filter2_f_2690_2519)">
						<circle cx="1115.2" cy="1049.99" r="290.366" fill="white"/>
						</g>
						<defs>
						<filter id="filter0_f_2690_2519" x="0" y="0" width="2157.24" height="2157.24" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter1_f_2690_2519" x="147.716" y="103.766" width="1934.96" height="1934.96" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						<filter id="filter2_f_2690_2519" x="269.831" y="204.621" width="1690.73" height="1690.73" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
						<feFlood flood-opacity="0" result="BackgroundImageFix"/>
						<feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape"/>
						<feGaussianBlur stdDeviation="277.5" result="effect1_foregroundBlur_2690_2519"/>
						</filter>
						</defs>
					</svg>										
				</div>
				
				<svg width="10" height="16" class="left-trb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="left-trb-n-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4.99219 0H0.0302734H0V15.0172H4.99609V10.0172H10.0039V5.01671H4.99219V0Z" fill="currentColor"/>
				</svg>
				<svg width="10" height="16" class="right-tlb-n-vec" viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M5.01172 15.0172L9.97363 15.0172L10.0039 15.0172L10.0039 0L5.00781 4.36772e-07L5.00781 5L-8.75732e-07 5L-4.38575e-07 10.0005L5.01172 10.0005L5.01172 15.0172Z" fill="currentColor"/>
				</svg>
			</div>
		</section>

		<section class="section--cls glb-sec-pad-out">
			<div class="section--cls__con">
				<div class="section--cls__main">

				</div>
			</div>
		</section>
	</main>
</Layout>
