---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../partials/navbar.astro";
import Header from "../../partials/header.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getFeaturedProjects, getProjects } from "../../lib/content";

const projects = getProjects();
const featuredProjects = getFeaturedProjects();
const featuredSlugs = new Set(featuredProjects.map((project) => project.slug));
const remainingProjects = projects.filter((project) => !featuredSlugs.has(project.slug));
---

<Layout
	title="Projects | Zach Portfolio"
	description="Browse Zach's projects — fullstack development and UI/UX design work across websites, portfolios, and web systems."
>
	<main class="projects projects--all">
		<Header />
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block">
			<div class="section--hero__main">
				<h1>All <span>projects</span></h1>
				<p>
					A collection of fullstack builds and UI/UX work — websites, portfolios, and web systems.
				</p>
			</div>
		</section>

		<section class="section--grid glb-pad-inline">
			<CategoryFilter activeCategory="all" />

			{
				featuredProjects.length > 0 && (
					<>
						<div class="section--grid__header">
							<h2>Featured <span>work</span></h2>
						</div>
						<div class="content-grid content-grid--featured">
							{featuredProjects.map((project) => (
								<ProjectCard project={project} featured />
							))}
						</div>
					</>
				)
			}

			<div class="section--grid__header">
				<h2>All <span>projects</span></h2>
			</div>
			<div class="content-grid">
				{remainingProjects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		</section>
	</main>
</Layout>
