<script>
	const root = document.querySelector("[data-text-rotate]");
	if (root && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const line = root.querySelector("span");
		const texts = JSON.parse(root.dataset.texts || "[]");
		if (line && texts.length > 1) {
			let i = 0;
			setInterval(() => {
				line.classList.add("is-out");
				setTimeout(() => {
					i = (i + 1) % texts.length;
					line.textContent = texts[i];
					line.classList.remove("is-out");
					line.classList.add("is-in");
					line.onanimationend = () => line.classList.remove("is-in");
				}, 450);
			}, 3200);
		}
	}
</script>

