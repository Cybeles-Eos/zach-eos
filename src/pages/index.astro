					</svg>
				</div>

				<div class="banners-container">
					<img src="/banners/servease.png" alt="montecarlo_builders">
					<img src="/banners/montecarlo_builders.png" alt="servease">
					<img src="/banners/portfolio.png" alt="portfolio">
					<img src="/banners/art.png" alt="art">
					<img src="/banners/healthy.png" alt="healthy">
					<!-- <img src="/banners/montecarlo_builders.png" alt="montecarlo_builders">
					<img src="/banners/servease.png" alt="servease"> -->
				</div>

			</div>
		</section>

		<section class="section--tech glb-sec-pad-out">
			<div class="section--tech__con">
				<div class="section--tech__main">
					<div class="section--tech__main--title">
						<p>My Techstack</p>

						<svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path d="M5.01172 10.0005L10.0039 10.0004L10.0039 -1.52588e-05L5.00781 -1.4822e-05L5.00781 4.99998L-4.37158e-07 4.99998L0 10.0005L5.01172 10.0005Z" fill="currentcolor"/>
						</svg>
					</div>
					<div class="section--tech__main--list">
						<div class="tech-slider__track">
							<div class="tech-slider__group">
								{TECH_LANGUAGES.map((item) => (
									<SkillsBox item={item} />
								))}
							</div>
							<div class="tech-slider__group" aria-hidden="true">
								{TECH_LANGUAGES.map((item) => (
									<SkillsBox item={item} />
								))}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section--abt glb-sec-pad-out">
			<div class="section--abt__con">
				<div class="section--abt__main glb-sec-pad">
					<img src="/images/noise.png" class="noise" alt="banners">
