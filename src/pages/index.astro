---
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";

const rollImages = ["/images/t2.png", "/images/t3.png"];
---

<Layout>
	{rollImages.map((src) => (
		<link slot="head" rel="preload" as="image" href={src} />
	))}

	<main class="home">
		<Header />
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block"> 
			<span class="hand-left" aria-hidden="true"></span>

			<div class="section--hero__main">
				<div class="pret">
					<svg width="27" height="24" viewBox="0 0 27 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M10.1076 6.613C9.87444 8.25527 11.3144 9.77924 11.3144 9.77924C11.3144 9.77924 13.1324 8.64055 13.3654 6.99828C13.5986 5.356 12.1587 3.83203 12.1587 3.83203C12.1587 3.83203 10.3407 4.97072 10.1076 6.613Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
						<path d="M8.39898 12.1321C9.15988 13.6354 11.2679 14.2254 11.2679 14.2254C11.2679 14.2254 12.1421 12.3778 11.3813 10.8745C10.6203 9.37118 8.51238 8.78125 8.51238 8.78125C8.51238 8.78125 7.63808 10.6287 8.39898 12.1321Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
