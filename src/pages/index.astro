---
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import Header from "../partials/header.astro";
import SkillsSection from "../partials/skills-section.astro";
import SkillsBox from "../components/skills-box.astro";
import { TECH_LANGUAGES } from "../data/techLanguages";

const heroTexts = [
	"Real Web Industry Experience",
	// "Coding since 2022",
	"Available For Opportunities",
	// "Full-Stack Web Projects",
];

const scrollBannerPreloads = [
	"/images/scroll-banners/banner-1.png",
	"/images/scroll-banners/banner-2.png",
	"/images/scroll-banners/banner-3.png",
	"/images/scroll-banners/banner-4.png",
	"/images/scroll-banners/banner-5.png",
	"/images/scroll-banners/banner-6.png",
	"/images/scroll-banners/banner-7.png",
	"/images/scroll-banners/banner-8.png",
	"/images/scroll-banners/banner-9.png",
	"/images/scroll-banners/banner-10.png",
	"/images/scroll-banners/banner-11.png",
	"/images/scroll-banners/banner-12.png",
	"/images/scroll-banners/banner-13.png",
	"/images/scroll-banners/banner-14.png",
	"/images/scroll-banners/banner-15.png",
	"/images/scroll-banners/banner-16.png",
	"/images/scroll-banners/banner-17.png",
	"/images/scroll-banners/banner-18.png",
	"/images/scroll-banners/banner-19.png",
	"/images/scroll-banners/banner-20.png",
	"/images/scroll-banners/banner-21.png",
	"/images/scroll-banners/banner-22.png",
	"/images/scroll-banners/banner-23.png",
	"/images/scroll-banners/banner-24.png",
];


---

<Layout>
	<Fragment slot="head">
		{scrollBannerPreloads.map((href) => (
			<link rel="preload" href={href} as="image" />
		))}
	</Fragment>
	<main class="home">
		<Header />
		<Navbar />

		<section class="section--hero">
			<div class="section--hero__grid" aria-hidden="true"></div>
			<!-- <img src="images/dots-hero.svg" class="section--hero__dots"> -->
			<div class="section--hero__main glb-pad-inline">

				<h1>Simple ideas to<br>Clean <span>websites</span> experiences</h1>

				<p>Hi, I’m Zach a junior full-stack developer focused on UIUX, frontend and backend development. I build clean, modern and responsive web systems.</p>
				<a href="#" class="btn btn--main-hero">Let’s Work Together</a>
				<div class="pret-title-hero">
					<svg width="27" height="24" viewBox="0 0 27 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M10.1076 6.613C9.87444 8.25527 11.3144 9.77924 11.3144 9.77924C11.3144 9.77924 13.1324 8.64055 13.3654 6.99828C13.5986 5.356 12.1587 3.83203 12.1587 3.83203C12.1587 3.83203 10.3407 4.97072 10.1076 6.613Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
