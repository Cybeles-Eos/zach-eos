					</svg>		
					<div class="text-rotate" data-text-rotate data-texts={JSON.stringify(heroTexts)}>
						<span>{heroTexts[0]}</span>
					</div>
					<svg width="27" height="24" viewBox="0 0 27 24" fill="none" xmlns="http://www.w3.org/2000/svg">
						<path d="M16.1288 6.613C16.3619 8.25527 14.9219 9.77924 14.9219 9.77924C14.9219 9.77924 13.104 8.64055 12.8709 6.99828C12.6377 5.356 14.0777 3.83203 14.0777 3.83203C14.0777 3.83203 15.8956 4.97072 16.1288 6.613Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
