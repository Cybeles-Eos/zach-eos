---
import Layout from "../layouts/Layout.astro";
import Navbar from "../partials/navbar.astro";
import ScreenLoader from "../partials/screen-loader.astro";

// flip to false to load the page without the preloader
const SHOW_LOADER = true;

const rollImages = ["/images/Onboarding.png", "/images/t2.png", "/images/t3.png"];
---

<Layout title="Zach — Portfolio" description="Software developer portfolio">
	{rollImages.map((src) => (
		<link slot="head" rel="preload" as="image" href={src} />
	))}

	<ScreenLoader scope=".home" enabled={SHOW_LOADER} />

	<main class="home">
		<Navbar />

		<section class="section--hero glb-pad-inline glb-pad-block"> 

			<div class="section--hero__main">
				<h1>Where visual ideas become clean <span>website experiences</span></h1>
				<p>Hi, I’m Zach, a junior full-stack developer with a solid background and  in UI, UX, and frontend development. I help clients and companies build clean, modern websites, portfolios and web systems.</p>
			</div>
			
				
		</section>
		<section class="section--roll"> 
			<div class="section--roll__gallery">
				{rollImages.map((src) => (
					<img src={src} alt="" width="400" height="400" loading="eager" decoding="sync" />
				))}
			</div>
		</section>

		<section class="section--about"> 

		</section>

		
	</main>

	<div style="height: 100vh; width: 100%; background-color: #0d739b;"></div>
</Layout>

