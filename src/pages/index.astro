						<path d="M16.1288 6.613C16.3619 8.25527 14.9219 9.77924 14.9219 9.77924C14.9219 9.77924 13.104 8.64055 12.8709 6.99828C12.6377 5.356 14.0777 3.83203 14.0777 3.83203C14.0777 3.83203 15.8956 4.97072 16.1288 6.613Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
